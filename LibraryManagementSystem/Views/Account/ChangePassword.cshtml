@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }

<div class="form-card" style="max-width:480px;">
    <div class="card-header"><h3>🔑 Change Password</h3></div>
    <div class="card-body">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="CurrentPassword" class="form-label">Current Password <span class="required">*</span></label>
                <input asp-for="CurrentPassword" class="form-control" />
                <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
            </div>
            <div class="form-group" style="margin-top:16px;">
                <label asp-for="NewPassword" class="form-label">New Password <span class="required">*</span></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>
            <div class="form-group" style="margin-top:16px;">
                <label asp-for="ConfirmPassword" class="form-label">Confirm New Password <span class="required">*</span></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
            <div class="form-actions">
                <a href="@Url.Action("Profile")" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Password</button>
            </div>
        </form>
    </div>
</div>
