@model List<LibraryManagementSystem.Models.AuditLog>
@{ ViewData["Title"] = "Audit Logs"; }

<div class="page-header">
    <h1>📋 System Audit Logs</h1>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="AuditLogs">
            <div class="search-bar">
                <div class="search-input-group">
                    <span class="search-icon">🔍</span>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search logs by action, description..." class="form-control" style="padding-left:40px;" />
                </div>
                <input type="text" name="action" value="@ViewBag.Action" placeholder="Action (e.g. Login, IssueBook)" class="form-control" style="max-width:180px;" />
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

<p class="text-muted text-sm mb-2">Showing @Model.Count of @ViewBag.TotalCount log entries</p>

<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>User ID</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Entity ID</th>
                    <th>Description</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="text-sm" style="white-space:nowrap;">@log.CreatedAt.ToString("MMM dd, yyyy HH:mm:ss")</td>
                        <td class="text-xs text-muted">@(log.UserId ?? "System")</td>
                        <td><span class="badge badge-issued">@log.Action</span></td>
                        <td>@log.EntityName</td>
                        <td class="text-xs text-muted">@log.EntityId</td>
                        <td class="text-sm">@log.Description</td>
                        <td class="text-xs text-muted">@(log.IPAddress ?? "Local")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            <a href="@Url.Action("AuditLogs", new { searchTerm = ViewBag.SearchTerm, action = ViewBag.Action, page = i })" class="@(i == (int)ViewBag.CurrentPage ? "active" : "")">@i</a>
        }
    </div>
}
