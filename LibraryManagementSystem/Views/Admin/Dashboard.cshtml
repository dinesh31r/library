@model AdminDashboardViewModel
@{ ViewData["Title"] = "Admin Dashboard"; }

<div class="stats-grid">
    <div class="stat-card primary">
        <div class="stat-icon">📖</div>
        <div class="stat-info"><div class="stat-value">@Model.TotalBooks</div><div class="stat-label">Total Books</div></div>
    </div>
    <div class="stat-card info">
        <div class="stat-icon">📦</div>
        <div class="stat-info"><div class="stat-value">@Model.TotalCopies</div><div class="stat-label">Total Copies</div></div>
    </div>
    <div class="stat-card success">
        <div class="stat-icon">✅</div>
        <div class="stat-info"><div class="stat-value">@Model.AvailableCopies</div><div class="stat-label">Available</div></div>
    </div>
    <div class="stat-card accent">
        <div class="stat-icon">📤</div>
        <div class="stat-info"><div class="stat-value">@Model.IssuedBooks</div><div class="stat-label">Issued Books</div></div>
    </div>
    <div class="stat-card danger">
        <div class="stat-icon">⏰</div>
        <div class="stat-info"><div class="stat-value">@Model.OverdueBooks</div><div class="stat-label">Overdue</div></div>
    </div>
    <div class="stat-card primary">
        <div class="stat-icon">👥</div>
        <div class="stat-info"><div class="stat-value">@Model.TotalUsers</div><div class="stat-label">Users</div></div>
    </div>
    <div class="stat-card info">
        <div class="stat-icon">👤</div>
        <div class="stat-info"><div class="stat-value">@Model.TotalLibrarians</div><div class="stat-label">Librarians</div></div>
    </div>
    <div class="stat-card warning">
        <div class="stat-icon">🔖</div>
        <div class="stat-info"><div class="stat-value">@Model.PendingReservations</div><div class="stat-label">Reservations</div></div>
    </div>
    <div class="stat-card danger">
        <div class="stat-icon">💰</div>
        <div class="stat-info"><div class="stat-value">₹@Model.OutstandingFines.ToString("F0")</div><div class="stat-label">Outstanding Fines</div></div>
    </div>
</div>

<div class="dashboard-grid">
    <div class="card">
        <div class="card-header"><h3>📈 Monthly Borrowing Activity</h3></div>
        <div class="card-body">
            <div class="chart-container"><canvas id="monthlyChart"></canvas></div>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h3>📚 Books by Category</h3></div>
        <div class="card-body">
            <div class="chart-container"><canvas id="categoryChart"></canvas></div>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h3>🏆 Most Borrowed Books</h3></div>
        <div class="card-body">
            @if (Model.MostBorrowed.Any())
            {
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead><tr><th>#</th><th>Title</th><th>Author</th><th>Borrows</th></tr></thead>
                        <tbody>
                            @{ var rank = 1; }
                            @foreach (var b in Model.MostBorrowed)
                            {
                                <tr>
                                    <td><strong>@(rank++)</strong></td>
                                    <td>@b.Title</td>
                                    <td class="text-muted">@b.Author</td>
                                    <td><span class="badge badge-issued">@b.BorrowCount</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state"><div class="icon">📊</div><p>No borrowing data yet</p></div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script>
        // Monthly Issued/Returned chart
        const monthlyCtx = document.getElementById('monthlyChart');
        if (monthlyCtx) {
            const issued = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyIssued));
            const returned = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyReturned));
            const allLabels = [...new Set([...Object.keys(issued), ...Object.keys(returned)])].sort();

            new Chart(monthlyCtx, {
                type: 'bar',
                data: {
                    labels: allLabels.map(l => { const [y,m] = l.split('-'); return new Date(y, m-1).toLocaleDateString('en', {month:'short', year:'2-digit'}); }),
                    datasets: [
                        { label: 'Issued', data: allLabels.map(l => issued[l] || 0), backgroundColor: 'rgba(26,54,93,0.8)', borderRadius: 4 },
                        { label: 'Returned', data: allLabels.map(l => returned[l] || 0), backgroundColor: 'rgba(34,197,94,0.8)', borderRadius: 4 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
            });
        }

        // Category chart
        const catCtx = document.getElementById('categoryChart');
        if (catCtx) {
            const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BooksByCategory));
            const colors = ['#1a365d','#d69e2e','#22c55e','#ef4444','#3b82f6','#8b5cf6','#ec4899','#f59e0b','#06b6d4','#84cc16'];
            new Chart(catCtx, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(catData),
                    datasets: [{ data: Object.values(catData), backgroundColor: colors.slice(0, Object.keys(catData).length), borderWidth: 2, borderColor: '#fff' }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } }
            });
        }
    </script>
}
