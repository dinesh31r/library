@model UserEditViewModel
@{ ViewData["Title"] = "Edit User"; }

<div class="form-card" style="max-width:600px;">
    <div class="card-header"><h3>✏️ Edit User — @Model.FullName</h3></div>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <form asp-action="EditUser" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="form-grid">
                <div class="form-group"><label asp-for="FullName" class="form-label">Full Name <span class="required">*</span></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="field-validation-error"></span></div>
                <div class="form-group"><label asp-for="Email" class="form-label">Email <span class="required">*</span></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="field-validation-error"></span></div>
                <div class="form-group">
                    <label asp-for="Role" class="form-label">Role <span class="required">*</span></label>
                    <select asp-for="Role" class="form-control">
                        <option value="User" selected="@(Model.Role == "User")">User / Student</option>
                        <option value="Librarian" selected="@(Model.Role == "Librarian")">Librarian</option>
                        <option value="Admin" selected="@(Model.Role == "Admin")">System Administrator</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <div class="form-check" style="margin-top:8px;">
                        <input asp-for="IsActive" type="checkbox" />
                        <label asp-for="IsActive">Account Active</label>
                    </div>
                </div>
                <div class="form-group"><label asp-for="PhoneNumber" class="form-label">Phone Number</label><input asp-for="PhoneNumber" class="form-control" /></div>
                <div class="form-group"><label asp-for="Address" class="form-label">Address</label><input asp-for="Address" class="form-control" /></div>
            </div>
            <div class="form-actions">
                <a href="@Url.Action("Users")" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
