@model LibraryManagementSystem.Models.LibrarySetting
@{ ViewData["Title"] = "System Settings"; }

<div class="form-card" style="max-width:700px;">
    <div class="card-header"><h3>⚙️ System & Business Rules Settings</h3></div>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <form asp-action="Settings" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="DefaultBorrowingDays" class="form-label">Default Borrowing Period (Days)</label>
                    <input asp-for="DefaultBorrowingDays" class="form-control" type="number" min="1" max="180" />
                </div>
                <div class="form-group">
                    <label asp-for="MaxBooksPerUser" class="form-label">Max Borrowed Books Per User</label>
                    <input asp-for="MaxBooksPerUser" class="form-control" type="number" min="1" max="20" />
                </div>
                <div class="form-group">
                    <label asp-for="FinePerDay" class="form-label">Fine Per Overdue Day (₹)</label>
                    <input asp-for="FinePerDay" class="form-control" type="number" step="0.50" min="0" />
                </div>
                <div class="form-group">
                    <label asp-for="MaxRenewals" class="form-label">Max Allowed Renewals</label>
                    <input asp-for="MaxRenewals" class="form-control" type="number" min="0" max="10" />
                </div>
                <div class="form-group">
                    <label asp-for="ReservationExpiryDays" class="form-label">Reservation Hold Period (Days)</label>
                    <input asp-for="ReservationExpiryDays" class="form-control" type="number" min="1" max="14" />
                </div>
                <div class="form-group full-width" style="border-top:1px solid var(--gray-200);padding-top:16px;margin-top:8px;">
                    <label class="form-label">Policy Restrictions</label>
                    <div class="d-flex flex-wrap gap-2 mt-1">
                        <label class="form-check">
                            <input asp-for="BlockIssueOnOverdue" type="checkbox" />
                            <span>Block issuing new books if user has overdue items</span>
                        </label>
                        <label class="form-check">
                            <input asp-for="BlockIssueOnFine" type="checkbox" />
                            <span>Block issuing new books if user has outstanding fines</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Settings</button>
            </div>
        </form>
    </div>
</div>
