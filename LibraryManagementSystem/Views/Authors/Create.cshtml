@model LibraryManagementSystem.Models.Author
@{ ViewData["Title"] = "Add Author"; }

<div class="form-card" style="max-width:560px;">
    <div class="card-header"><h3>➕ Add Author</h3></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group"><label asp-for="Name" class="form-label">Name <span class="required">*</span></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
            <div class="form-group" style="margin-top:16px;"><label asp-for="Biography" class="form-label">Biography</label><textarea asp-for="Biography" class="form-control" rows="4"></textarea></div>
            <div class="form-actions">
                <a href="@Url.Action("Index")" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Author</button>
            </div>
        </form>
    </div>
</div>
