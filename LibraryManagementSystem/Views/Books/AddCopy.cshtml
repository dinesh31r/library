@model BookCopyCreateViewModel
@{ ViewData["Title"] = "Add Copy"; }

<div class="form-card" style="max-width:560px;">
    <div class="card-header"><h3>➕ Add Copy — @Model.BookTitle</h3></div>
    <div class="card-body">
        <form asp-action="AddCopy" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BookId" />
            <div class="form-grid">
                <div class="form-group"><label asp-for="AccessionNumber" class="form-label">Accession Number <span class="required">*</span></label><input asp-for="AccessionNumber" class="form-control" /><span asp-validation-for="AccessionNumber" class="field-validation-error"></span></div>
                <div class="form-group"><label asp-for="Barcode" class="form-label">Barcode <span class="required">*</span></label><input asp-for="Barcode" class="form-control" /><span asp-validation-for="Barcode" class="field-validation-error"></span></div>
                <div class="form-group"><label asp-for="Condition" class="form-label">Condition</label><input asp-for="Condition" class="form-control" /></div>
                <div class="form-group"><label asp-for="Price" class="form-label">Price (₹)</label><input asp-for="Price" class="form-control" type="number" step="0.01" /></div>
                <div class="form-group"><label asp-for="PurchaseDate" class="form-label">Purchase Date</label><input asp-for="PurchaseDate" class="form-control" type="date" /></div>
                <div class="form-group"><label asp-for="ShelfLocation" class="form-label">Shelf Location</label><input asp-for="ShelfLocation" class="form-control" /></div>
            </div>
            <div class="form-actions">
                <a href="@Url.Action("Details", new { id = Model.BookId })" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary">Add Copy</button>
            </div>
        </form>
    </div>
</div>
