@model BookCreateViewModel
@{ ViewData["Title"] = "Add Book"; }

<div class="form-card">
    <div class="card-header"><h3>➕ Add New Book</h3></div>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div class="form-group"><label asp-for="ISBN" class="form-label">ISBN <span class="required">*</span></label><input asp-for="ISBN" class="form-control" /><span asp-validation-for="ISBN" class="field-validation-error"></span></div>
                <div class="form-group"><label asp-for="Title" class="form-label">Title <span class="required">*</span></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="field-validation-error"></span></div>
                <div class="form-group"><label asp-for="AuthorId" class="form-label">Author <span class="required">*</span></label><select asp-for="AuthorId" asp-items="Model.Authors" class="form-control"><option value="">Select Author</option></select></div>
                <div class="form-group"><label asp-for="CategoryId" class="form-label">Category <span class="required">*</span></label><select asp-for="CategoryId" asp-items="Model.Categories" class="form-control"><option value="">Select Category</option></select></div>
                <div class="form-group"><label asp-for="PublisherId" class="form-label">Publisher <span class="required">*</span></label><select asp-for="PublisherId" asp-items="Model.Publishers" class="form-control"><option value="">Select Publisher</option></select></div>
                <div class="form-group"><label asp-for="PublicationYear" class="form-label">Publication Year</label><input asp-for="PublicationYear" class="form-control" type="number" /></div>
                <div class="form-group"><label asp-for="Edition" class="form-label">Edition</label><input asp-for="Edition" class="form-control" /></div>
                <div class="form-group"><label asp-for="Language" class="form-label">Language</label><input asp-for="Language" class="form-control" /></div>
                <div class="form-group"><label asp-for="InitialCopies" class="form-label">Initial Copies <span class="required">*</span></label><input asp-for="InitialCopies" class="form-control" type="number" min="1" /></div>
                <div class="form-group"><label asp-for="ShelfLocation" class="form-label">Shelf Location</label><input asp-for="ShelfLocation" class="form-control" /></div>
                <div class="form-group full-width"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
            </div>
            <div class="form-actions">
                <a href="@Url.Action("Index")" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary">Create Book</button>
            </div>
        </form>
    </div>
</div>
