@model BookDetailViewModel
@{ ViewData["Title"] = Model.Title; }

<div class="page-header">
    <div>
        <div class="breadcrumb"><a href="@Url.Action("Index")">Books</a> / <span>@Model.Title</span></div>
        <h1>@Model.Title</h1>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
    {
        <div class="d-flex gap-1">
            <a href="@Url.Action("Edit", new { id = Model.BookId })" class="btn btn-primary">✏️ Edit</a>
            <a href="@Url.Action("AddCopy", new { bookId = Model.BookId })" class="btn btn-accent">➕ Add Copy</a>
        </div>
    }
</div>

<div class="dashboard-grid">
    <div class="card">
        <div class="card-header"><h3>📖 Book Information</h3></div>
        <div class="card-body">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;font-size:0.88rem;">
                <div><strong>ISBN:</strong> @Model.ISBN</div>
                <div><strong>Author:</strong> @Model.Author</div>
                <div><strong>Category:</strong> @Model.Category</div>
                <div><strong>Publisher:</strong> @Model.Publisher</div>
                <div><strong>Year:</strong> @(Model.PublicationYear?.ToString() ?? "N/A")</div>
                <div><strong>Edition:</strong> @(Model.Edition ?? "N/A")</div>
                <div><strong>Language:</strong> @(Model.Language ?? "N/A")</div>
                <div><strong>Shelf:</strong> @(Model.ShelfLocation ?? "N/A")</div>
                <div><strong>Total Copies:</strong> @Model.TotalCopies</div>
                <div><strong>Available:</strong> <span class="badge @(Model.AvailableCopies > 0 ? "badge-available" : "badge-overdue")">@Model.AvailableCopies</span></div>
                <div><strong>Status:</strong> <span class="badge @(Model.IsActive ? "badge-active" : "badge-inactive")">@(Model.IsActive ? "Active" : "Inactive")</span></div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--gray-200);">
                    <strong>Description:</strong>
                    <p class="text-muted" style="margin-top:4px;">@Model.Description</p>
                </div>
            }
            @if (Model.CanReserve)
            {
                <form asp-controller="Books" asp-action="Reserve" method="post" style="margin-top:16px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookId" value="@Model.BookId" />
                    <button type="submit" class="btn btn-accent">🔖 Reserve This Book</button>
                </form>
            }
            @if (Model.HasActiveReservation)
            {
                <div class="alert alert-info" style="margin-top:16px;">You have an active reservation for this book.</div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h3>📦 Physical Copies (@Model.Copies.Count)</h3></div>
        <div class="card-body">
            @if (Model.Copies.Any())
            {
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Accession #</th><th>Barcode</th><th>Status</th><th>Condition</th></tr></thead>
                        <tbody>
                            @foreach (var copy in Model.Copies)
                            {
                                var badgeClass = copy.Status switch { BookCopyStatus.Available => "badge-available", BookCopyStatus.Issued => "badge-issued", BookCopyStatus.Reserved => "badge-reserved", BookCopyStatus.Lost => "badge-lost", BookCopyStatus.Damaged => "badge-damaged", _ => "badge-pending" };
                                <tr>
                                    <td>@copy.AccessionNumber</td>
                                    <td class="text-muted">@copy.Barcode</td>
                                    <td><span class="badge @badgeClass">@copy.Status</span></td>
                                    <td>@(copy.Condition ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else { <div class="empty-state"><p>No copies registered</p></div> }
        </div>
    </div>
</div>
