@model BookListViewModel
@{ ViewData["Title"] = "Book Catalog"; }

<div class="page-header">
    <h1>📖 Book Catalog</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
    {
        <a href="@Url.Action("Create")" class="btn btn-primary">➕ Add Book</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <form id="book-search-form" method="get" asp-action="Index">
            <div class="search-bar">
                <div class="search-input-group">
                    <span class="search-icon">🔍</span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search by title, ISBN, author..." class="form-control" style="padding-left:40px;" />
                </div>
                <select name="categoryId" class="form-control" style="max-width:200px;" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var c in Model.Categories) { <option value="@c.Value" selected="@(c.Value == Model.CategoryId?.ToString())">@c.Text</option> }
                </select>
                <select name="authorId" class="form-control" style="max-width:200px;" onchange="this.form.submit()">
                    <option value="">All Authors</option>
                    @foreach (var a in Model.Authors) { <option value="@a.Value" selected="@(a.Value == Model.AuthorId?.ToString())">@a.Text</option> }
                </select>
                <label class="form-check" style="white-space:nowrap;">
                    <input type="checkbox" name="availableOnly" value="true" @(Model.AvailableOnly == true ? "checked" : "") onchange="this.form.submit()" />
                    Available only
                </label>
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>
    </div>
</div>

<p class="text-muted text-sm mb-2">Showing @Model.Books.Count of @Model.TotalCount books</p>

<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr><th>Title</th><th>ISBN</th><th>Author</th><th>Category</th><th>Available</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td><strong>@book.Title</strong></td>
                        <td class="text-muted text-sm">@book.ISBN</td>
                        <td>@book.Author</td>
                        <td><span class="badge badge-issued">@book.Category</span></td>
                        <td>@book.AvailableCopies / @book.TotalCopies</td>
                        <td>
                            @if (book.AvailableCopies > 0) { <span class="badge badge-available">Available</span> }
                            else { <span class="badge badge-overdue">Unavailable</span> }
                        </td>
                        <td class="actions">
                            <a href="@Url.Action("Details", new { id = book.BookId })" class="btn btn-sm btn-outline">View</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                            {
                                <a href="@Url.Action("Edit", new { id = book.BookId })" class="btn btn-sm btn-primary">Edit</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, categoryId = Model.CategoryId, authorId = Model.AuthorId, availableOnly = Model.AvailableOnly, page = i })"
               class="@(i == Model.CurrentPage ? "active" : "")">@i</a>
        }
    </div>
}

@section Scripts { <script src="~/js/books.js"></script> }
