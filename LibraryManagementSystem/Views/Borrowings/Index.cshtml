@model List<LibraryManagementSystem.Models.Borrowing>
@{ ViewData["Title"] = "All Borrowings"; }

<div class="page-header">
    <h1>📑 All Borrowings</h1>
    <a href="@Url.Action("Issue")" class="btn btn-primary">📤 Issue Book</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="search-bar">
                <div class="search-input-group">
                    <span class="search-icon">🔍</span>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search by book, user, accession #..." class="form-control" style="padding-left:40px;" />
                </div>
                <select name="status" class="form-control" style="max-width:180px;">
                    <option value="">All Status</option>
                    <option value="Issued" selected="@(ViewBag.Status == "Issued")">Issued</option>
                    <option value="Returned" selected="@(ViewBag.Status == "Returned")">Returned</option>
                    <option value="Overdue" selected="@(ViewBag.Status == "Overdue")">Overdue</option>
                </select>
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead><tr><th>User</th><th>Book</th><th>Accession #</th><th>Issue Date</th><th>Due Date</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    var isOverdue = b.Status == BorrowingStatus.Issued && b.DueDate < DateTime.UtcNow;
                    var badgeClass = b.Status == BorrowingStatus.Returned ? "badge-returned" : isOverdue ? "badge-overdue" : "badge-issued";
                    <tr>
                        <td>@b.User?.FullName</td>
                        <td>@b.BookCopy?.Book?.Title</td>
                        <td class="text-muted text-sm">@b.BookCopy?.AccessionNumber</td>
                        <td>@b.IssueDate.ToString("MMM dd, yyyy")</td>
                        <td class="@(isOverdue ? "text-danger fw-600" : "")">@b.DueDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="badge @badgeClass">@(isOverdue ? "Overdue" : b.Status.ToString())</span></td>
                        <td class="actions">
                            @if (b.Status == BorrowingStatus.Issued)
                            {
                                <a href="@Url.Action("Return", new { id = b.BorrowingId })" class="btn btn-sm btn-success">Return</a>
                                <form asp-action="Renew" method="post" style="display:inline;"><input type="hidden" name="id" value="@b.BorrowingId" />@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline">Renew</button></form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (ViewBag.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            <a href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, status = ViewBag.Status, page = i })" class="@(i == (int)ViewBag.CurrentPage ? "active" : "")">@i</a>
        }
    </div>
}
