@model List<LibraryManagementSystem.Models.Borrowing>
@{ ViewData["Title"] = "Overdue Books"; }

<div class="page-header"><h1>⏰ Overdue Books</h1></div>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>User</th><th>Book</th><th>Accession #</th><th>Due Date</th><th>Overdue Days</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        var overdue = (DateTime.UtcNow - b.DueDate).Days;
                        <tr>
                            <td>@b.User?.FullName</td>
                            <td>@b.BookCopy?.Book?.Title</td>
                            <td class="text-muted">@b.BookCopy?.AccessionNumber</td>
                            <td class="text-danger fw-600">@b.DueDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge badge-overdue">@overdue days</span></td>
                            <td><a href="@Url.Action("Return", new { id = b.BorrowingId })" class="btn btn-sm btn-success">Return</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else { <div class="card-body"><div class="empty-state"><div class="icon">✅</div><p>No overdue books!</p></div></div> }
</div>
