@model ReturnBookViewModel
@{ ViewData["Title"] = "Return Book"; }

<div class="form-card" style="max-width:600px;">
    <div class="card-header"><h3>📥 Return Book</h3></div>
    <div class="card-body">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;font-size:0.88rem;">
            <div><strong>User:</strong> @Model.UserName</div>
            <div><strong>Book:</strong> @Model.BookTitle</div>
            <div><strong>Accession #:</strong> @Model.AccessionNumber</div>
            <div><strong>Issue Date:</strong> @Model.IssueDate.ToString("MMM dd, yyyy")</div>
            <div><strong>Due Date:</strong> <span class="@(Model.OverdueDays > 0 ? "text-danger" : "")">@Model.DueDate.ToString("MMM dd, yyyy")</span></div>
            <div><strong>Return Date:</strong> @DateTime.UtcNow.ToString("MMM dd, yyyy")</div>
        </div>

        @if (Model.OverdueDays > 0)
        {
            <div class="alert alert-danger">
                <strong>Overdue by @Model.OverdueDays day(s)</strong> — Fine: @Model.OverdueDays × ₹@Model.FinePerDay = <strong>₹@Model.CalculatedFine</strong>
            </div>
        }
        else
        {
            <div class="alert alert-success">✅ Book is being returned on time. No fine.</div>
        }

        <form asp-action="ProcessReturn" method="post" style="margin-top:16px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="borrowingId" value="@Model.BorrowingId" />
            <div class="form-group">
                <label class="form-label">Notes (optional)</label>
                <textarea name="notes" class="form-control" rows="2" placeholder="Any notes about the return..."></textarea>
            </div>
            <div class="form-actions">
                <a href="@Url.Action("Return")" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-success btn-lg" data-confirm="Confirm return of this book?">📥 Process Return</button>
            </div>
        </form>
    </div>
</div>
