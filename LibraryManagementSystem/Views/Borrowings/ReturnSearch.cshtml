@{ ViewData["Title"] = "Return Book"; }

<div class="form-card" style="max-width:560px;">
    <div class="card-header"><h3>📥 Return Book — Search</h3></div>
    <div class="card-body">
        <p class="text-muted mb-2">Enter accession number or barcode to find the borrowing record.</p>
        <div class="d-flex gap-1">
            <input type="text" id="return-lookup" class="form-control" placeholder="Accession number or barcode..." autofocus />
            <button id="return-lookup-btn" class="btn btn-primary">🔍 Find</button>
        </div>
    </div>
</div>

@section Scripts { <script src="~/js/borrowing.js"></script> }
