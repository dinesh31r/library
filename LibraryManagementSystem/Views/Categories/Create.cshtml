@model LibraryManagementSystem.Models.Category
@{ ViewData["Title"] = "Add Category"; }

<div class="form-card" style="max-width:500px;">
    <div class="card-header"><h3>➕ Add Category</h3></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group"><label asp-for="Name" class="form-label">Category Name <span class="required">*</span></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
            <div class="form-group" style="margin-top:16px;"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
            <div class="form-actions">
                <a href="@Url.Action("Index")" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Category</button>
            </div>
        </form>
    </div>
</div>
