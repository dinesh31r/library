@model List<LibraryManagementSystem.Models.Category>
@{ ViewData["Title"] = "Categories"; }

<div class="page-header">
    <h1>🏷️ Categories</h1>
    <a href="@Url.Action("Create")" class="btn btn-primary">➕ Add Category</a>
</div>

<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead><tr><th>Category Name</th><th>Description</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td><strong>@cat.Name</strong></td>
                        <td class="text-sm text-muted">@(cat.Description ?? "—")</td>
                        <td><span class="badge @(cat.IsActive ? "badge-active" : "badge-inactive")">@(cat.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="actions"><a href="@Url.Action("Edit", new { id = cat.CategoryId })" class="btn btn-sm btn-outline">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
