@model List<LibraryManagementSystem.Models.Notification>
@{ ViewData["Title"] = "Notifications"; }

<div class="page-header">
    <h1>🔔 Notifications</h1>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllAsRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline">Check All as Read</button>
        </form>
    }
</div>

<div class="card">
    @if (Model.Any())
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Title</th><th>Message</th><th>Received</th><th>Status</th><th>Action</th></tr></thead>
                <tbody>
                    @foreach (var n in Model)
                    {
                        <tr style="@(!n.IsRead ? "background:var(--primary-50);font-weight:600;" : "")">
                            <td>@n.Title</td>
                            <td class="text-sm">@n.Message</td>
                            <td class="text-xs text-muted" style="white-space:nowrap;">@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                @if (n.IsRead) { <span class="badge badge-returned">Read</span> }
                                else { <span class="badge badge-issued">New</span> }
                            </td>
                            <td>
                                @if (!n.IsRead)
                                {
                                    <form asp-action="MarkAsRead" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@n.NotificationId" />
                                        <button type="submit" class="btn btn-sm btn-outline">Mark Read</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body">
            <div class="empty-state"><div class="icon">🔔</div><p>No notifications.</p></div>
        </div>
    }
</div>
