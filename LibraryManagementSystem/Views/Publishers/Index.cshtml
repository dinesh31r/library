@model List<LibraryManagementSystem.Models.Publisher>
@{ ViewData["Title"] = "Publishers"; }

<div class="page-header">
    <h1>🏢 Publishers</h1>
    <a href="@Url.Action("Create")" class="btn btn-primary">➕ Add Publisher</a>
</div>

<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead><tr><th>Publisher Name</th><th>Address</th><th>Email</th><th>Phone</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var pub in Model)
                {
                    <tr>
                        <td><strong>@pub.Name</strong></td>
                        <td class="text-sm text-muted">@(pub.Address ?? "—")</td>
                        <td class="text-sm">@(pub.Email ?? "—")</td>
                        <td class="text-sm">@(pub.Phone ?? "—")</td>
                        <td><span class="badge @(pub.IsActive ? "badge-active" : "badge-inactive")">@(pub.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="actions"><a href="@Url.Action("Edit", new { id = pub.PublisherId })" class="btn btn-sm btn-outline">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
