@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    var statusCode = ViewBag.StatusCode ?? 500;
    var message = ViewBag.Message ?? "An unexpected error occurred.";
    var icon = statusCode == 404 ? "🔍" : statusCode == 403 ? "🔒" : "⚠️";
}

<div class="login-wrapper">
    <div class="login-card" style="text-align:center;">
        <div style="padding:48px 32px;">
            <div style="font-size:4rem;margin-bottom:16px;">@icon</div>
            <h1 style="font-size:3rem;font-weight:800;color:var(--primary);margin-bottom:8px;">@statusCode</h1>
            <p style="font-size:1rem;color:var(--gray-600);margin-bottom:24px;">@message</p>
            <a href="/" class="btn btn-primary btn-lg">Go to Home</a>
        </div>
    </div>
</div>
