@using Microsoft.AspNetCore.Identity
@using LibraryManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
    var role = roles.FirstOrDefault() ?? "";
    var initials = user != null ? string.Join("", user.FullName.Split(' ').Take(2).Select(n => n[0])).ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Library Management System</title>
    <meta name="description" content="Library Management System — Manage books, borrowings, fines, and reservations" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/forms.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar Overlay (mobile) -->
        <div id="sidebar-overlay" class="sidebar-overlay"></div>

        <!-- Sidebar -->
        <aside id="sidebar" class="sidebar">
            <div class="sidebar-brand">
                <div class="sidebar-brand-icon">📚</div>
                <div class="sidebar-brand-text">
                    LMS
                    <small>Library Management System</small>
                </div>
            </div>

            <nav class="sidebar-nav">
                @if (role == "Admin")
                {
                    <div class="sidebar-section-title">Administration</div>
                    <a href="@Url.Action("Dashboard", "Admin")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <span class="icon">📊</span> Dashboard
                    </a>
                    <a href="@Url.Action("Users", "Admin")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" || ViewContext.RouteData.Values["action"]?.ToString() == "CreateUser" || ViewContext.RouteData.Values["action"]?.ToString() == "EditUser" ? "active" : "")">
                        <span class="icon">👥</span> User Management
                    </a>
                    <a href="@Url.Action("Settings", "Admin")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                        <span class="icon">⚙️</span> Settings
                    </a>
                    <a href="@Url.Action("AuditLogs", "Admin")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")">
                        <span class="icon">📋</span> Audit Logs
                    </a>
                }

                @if (role == "Admin" || role == "Librarian")
                {
                    @if (role == "Librarian")
                    {
                        <div class="sidebar-section-title">Librarian</div>
                        <a href="@Url.Action("Dashboard", "Librarian")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Librarian" ? "active" : "")">
                            <span class="icon">📊</span> Dashboard
                        </a>
                    }

                    <div class="sidebar-section-title">Library</div>
                    <a href="@Url.Action("Index", "Books")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Books" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <span class="icon">📖</span> Books
                    </a>
                    <a href="@Url.Action("Index", "Authors")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Authors" ? "active" : "")">
                        <span class="icon">✍️</span> Authors
                    </a>
                    <a href="@Url.Action("Index", "Categories")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">
                        <span class="icon">🏷️</span> Categories
                    </a>
                    <a href="@Url.Action("Index", "Publishers")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Publishers" ? "active" : "")">
                        <span class="icon">🏢</span> Publishers
                    </a>

                    <div class="sidebar-section-title">Circulation</div>
                    <a href="@Url.Action("Issue", "Borrowings")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Issue" ? "active" : "")">
                        <span class="icon">📤</span> Issue Book
                    </a>
                    <a href="@Url.Action("Return", "Borrowings")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Return" || ViewContext.RouteData.Values["action"]?.ToString() == "ReturnSearch" ? "active" : "")">
                        <span class="icon">📥</span> Return Book
                    </a>
                    <a href="@Url.Action("Index", "Borrowings")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Borrowings" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <span class="icon">📑</span> All Borrowings
                    </a>
                    <a href="@Url.Action("Overdue", "Borrowings")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Overdue" ? "active" : "")">
                        <span class="icon">⏰</span> Overdue Books
                    </a>
                    <a href="@Url.Action("Index", "Fines")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fines" ? "active" : "")">
                        <span class="icon">💰</span> Fines
                    </a>
                    <a href="@Url.Action("Index", "Reservations")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" ? "active" : "")">
                        <span class="icon">🔖</span> Reservations
                    </a>
                    <a href="@Url.Action("Index", "Reports")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")">
                        <span class="icon">📈</span> Reports
                    </a>
                }

                @if (role == "User")
                {
                    <div class="sidebar-section-title">My Library</div>
                    <a href="@Url.Action("Dashboard", "User")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <span class="icon">📊</span> Dashboard
                    </a>
                    <a href="@Url.Action("Index", "Books")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Books" ? "active" : "")">
                        <span class="icon">📖</span> Browse Books
                    </a>
                    <a href="@Url.Action("MyBorrowings", "User")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyBorrowings" ? "active" : "")">
                        <span class="icon">📑</span> My Borrowings
                    </a>
                    <a href="@Url.Action("MyReservations", "User")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyReservations" ? "active" : "")">
                        <span class="icon">🔖</span> My Reservations
                    </a>
                    <a href="@Url.Action("MyFines", "User")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyFines" ? "active" : "")">
                        <span class="icon">💰</span> My Fines
                    </a>
                }

                <div class="sidebar-section-title">Account</div>
                <a href="@Url.Action("Profile", "Account")" class="sidebar-link">
                    <span class="icon">👤</span> Profile
                </a>
                <a href="@Url.Action("Index", "Notifications")" class="sidebar-link">
                    <span class="icon">🔔</span> Notifications
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <div class="navbar-left">
                    <button id="hamburger" class="hamburger" aria-label="Toggle sidebar">☰</button>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="navbar-right">
                    <a href="@Url.Action("Index", "Notifications")" class="notification-bell" title="Notifications">
                        🔔
                        <span id="notification-badge" class="notification-badge" style="display:none;">0</span>
                    </a>
                    <div class="user-dropdown">
                        <div class="user-avatar">@initials</div>
                        <div class="user-info">
                            <div class="name">@user?.FullName</div>
                            <div class="role">@role</div>
                        </div>
                        <div class="dropdown-menu">
                            <a href="@Url.Action("Profile", "Account")" class="dropdown-item">👤 Profile</a>
                            <a href="@Url.Action("ChangePassword", "Account")" class="dropdown-item">🔑 Change Password</a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item" style="width:100%;border:none;background:none;cursor:pointer;text-align:left;font-family:inherit;font-size:inherit;color:inherit;padding:8px 16px;">🚪 Logout</button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="page-content">
                <!-- Toast Container -->
                <div id="toast-container" class="toast-container">
                    @if (TempData["Success"] != null)
                    {
                        <div class="toast toast-success">
                            <span>✅ @TempData["Success"]</span>
                            <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="toast toast-error">
                            <span>❌ @TempData["Error"]</span>
                            <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
                        </div>
                    }
                </div>

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
