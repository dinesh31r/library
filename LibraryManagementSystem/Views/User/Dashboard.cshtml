@model UserDashboardViewModel
@{ ViewData["Title"] = "My Dashboard"; }

<div class="stats-grid">
    <div class="stat-card primary"><div class="stat-icon">📖</div><div class="stat-info"><div class="stat-value">@Model.CurrentlyBorrowed</div><div class="stat-label">Currently Borrowed</div></div></div>
    <div class="stat-card warning"><div class="stat-icon">📅</div><div class="stat-info"><div class="stat-value">@Model.DueSoon</div><div class="stat-label">Due Soon</div></div></div>
    <div class="stat-card danger"><div class="stat-icon">⏰</div><div class="stat-info"><div class="stat-value">@Model.OverdueCount</div><div class="stat-label">Overdue</div></div></div>
    <div class="stat-card accent"><div class="stat-icon">💰</div><div class="stat-info"><div class="stat-value">₹@Model.OutstandingFines.ToString("F0")</div><div class="stat-label">Outstanding Fines</div></div></div>
    <div class="stat-card info"><div class="stat-icon">🔖</div><div class="stat-info"><div class="stat-value">@Model.ActiveReservations</div><div class="stat-label">Reservations</div></div></div>
</div>

@if (Model.Alerts.Any())
{
    <div class="card mb-3">
        <div class="card-header"><h3>⚠️ Alerts</h3></div>
        <div class="card-body">
            <div class="alert-list">
                @foreach (var alert in Model.Alerts)
                {
                    var cssClass = alert.Contains("overdue") ? "overdue" : alert.Contains("due in") ? "due-soon" : "fine";
                    <div class="alert-item @cssClass">@alert</div>
                }
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3>📚 Currently Borrowed Books</h3>
        <a href="@Url.Action("MyBorrowings")" class="btn btn-sm btn-outline">View All</a>
    </div>
    <div class="card-body">
        @if (Model.ActiveBorrowings.Any())
        {
            <div class="borrowing-cards">
                @foreach (var b in Model.ActiveBorrowings)
                {
                    <div class="borrowing-card">
                        <div class="book-thumb">📖</div>
                        <div class="book-info">
                            <div class="book-title">@b.BookTitle</div>
                            <div class="book-author">@b.Author</div>
                            <div class="book-meta">
                                Issued: @b.IssueDate.ToString("MMM dd, yyyy") &nbsp;|&nbsp;
                                Due: <span class="due-date @(b.IsOverdue ? "overdue" : b.DaysRemaining <= 3 ? "due-soon" : "")">
                                    @b.DueDate.ToString("MMM dd, yyyy")
                                    @if (b.IsOverdue) { <text> (Overdue!)</text> }
                                    else if (b.DaysRemaining <= 3) { <text> (@b.DaysRemaining days left)</text> }
                                </span>
                            </div>
                            @if (b.RenewalCount < 2)
                            {
                                <form asp-controller="User" asp-action="RequestRenewal" method="post" style="margin-top:8px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@b.BorrowingId" />
                                    <button type="submit" class="btn btn-sm btn-outline">🔄 Renew</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state"><div class="icon">📖</div><p>No books currently borrowed</p></div>
        }
    </div>
</div>
